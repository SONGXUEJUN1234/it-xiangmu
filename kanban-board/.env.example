# ============================================
# 应用配置
# ============================================
APP_NAME=Kanban Board
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# ============================================
# 数据库配置
# ============================================
# PostgreSQL 连接 URL (异步)
DATABASE_URL=postgresql+asyncpg://kanban:kanban_password@localhost:5432/kanban_db

# ============================================
# JWT 认证配置
# ============================================
# 密钥 (生产环境请使用强随机字符串)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# 访问令牌过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# 刷新令牌过期时间 (天)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS 配置
# ============================================
# 允许的跨域源 (开发环境)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# Redis 配置 (用于 Socket.IO)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# 文件上传配置
# ============================================
# 最大上传大小 (MB)
MAX_UPLOAD_SIZE=10

# 上传目录
UPLOAD_DIR=./uploads
